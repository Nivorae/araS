{
  "name": "aras",
  "version": "0.1.0",
  "private": true,
  "description": "araS personal asset tracker: Expo iOS/Android app with a Next.js web app and API, Clerk auth, Prisma ORM.",
  "keywords": [
    "expo",
    "react-native",
    "nextjs",
    "prisma",
    "clerk",
    "typescript",
    "monorepo"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "db:generate": "pnpm --filter @repo/web db:generate",
    "db:push": "pnpm --filter @repo/web db:push",
    "db:migrate": "pnpm --filter @repo/web db:migrate",
    "db:migrate:deploy": "pnpm --filter @repo/web db:migrate:deploy",
    "db:rollback": "pnpm --filter @repo/web db:rollback",
    "db:seed": "pnpm --filter @repo/web db:seed",
    "db:check": "pnpm --filter @repo/web db:check",
    "db:reset": "pnpm --filter @repo/web db:reset",
    "db:studio": "pnpm --filter @repo/web db:studio",
    "prepare": "husky",
    "diagram:png": "node scripts/export-architecture-png.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.39.3",
    "eslint": "^9.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "playwright-core": "1.58.2",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.17",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.56.1"
  },
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript": ">=7.0.3",
      "effect": ">=3.20.0",
      "flatted": ">=3.4.2",
      "react-native-worklets": "0.10.1",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "vite@>=6.0.0 <6.4.3": "^6.4.3",
      "defu@<6.1.5": "^6.1.5",
      "@babel/plugin-transform-modules-systemjs@<7.29.4": "^7.29.4",
      "js-cookie@<3.0.7": "^3.0.7",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "brace-expansion@<1.1.20": "^1.1.20",
      "brace-expansion@>=2.0.0 <2.1.6": "^2.1.6",
      "brace-expansion@>=4.0.0 <5.0.11": "^5.0.11",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "shell-quote@<1.9.0": "^1.9.0",
      "fast-uri@<3.1.7": "^3.1.7",
      "postcss@<8.5.18": "^8.5.18",
      "nanoid@<3.3.18": "^3.3.18",
      "browserslist@<4.28.7": "^4.28.7",
      "@xmldom/xmldom@<0.8.15": "^0.8.15",
      "@xmldom/xmldom@>=0.9.0-0 <0.9.12": "^0.9.12"
    },
    "ignoredOptionalDependencies": [
      "sharp"
    ]
  }
}

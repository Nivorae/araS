{
  "expo": {
    "name": "Sara Asset",
    "slug": "sara-asset-app",
    "scheme": "saraasset",
    "platforms": ["ios", "android"],
    "version": "1.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/04fc306d-1109-4b7f-9d58-56e9a4c21710"
    },
    "ios": {
      "bundleIdentifier": "com.Sara.assetapp",
      "buildNumber": "1",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:ara-s-web.vercel.app", "applinks:arasasset.com"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.Sara.assetapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0a0a0f"
      },
      "blockedPermissions": ["com.google.android.gms.permission.AD_ID"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ara-s-web.vercel.app"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-local-authentication",
        { "faceIDPermission": "使用 Face ID 解鎖 araS，保護你的資產資料" }
      ],
      "@sentry/react-native",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 390,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0f"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "whatsNew": {
        "id": "2026-10-05-v1.6-overseas-stocks",
        "sections": [
          {
            "title": "新功能",
            "items": [
              "新增「海外股票」分類：用 Yahoo 搜尋選股，市值自動換算成台幣",
              "新增換匯計算機，支援 11 種常用幣別"
            ]
          },
          {
            "title": "優化",
            "items": [
              "編輯記錄時可以從日曆選日期",
              "離開畫面或關閉視窗時自動收起鍵盤",
              "底部面板改成淡入淡出，開關更順暢",
              "切換帳號時會清除前一個帳號的資料，退休規劃與選股紀錄改成各帳號分開保存",
              "修正 Face ID 鎖定畫面沒有蓋住彈出視窗的問題",
              "修正切換帳號後購買 Premium，可能記到前一個帳號的問題"
            ]
          }
        ]
      },
      "eas": {
        "projectId": "04fc306d-1109-4b7f-9d58-56e9a4c21710"
      }
    },
    "owner": "milk88084"
  }
}

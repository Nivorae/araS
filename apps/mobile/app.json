{
  "expo": {
    "name": "Sara Asset",
    "slug": "sara-asset-app",
    "scheme": "saraasset",
    "platforms": ["ios", "android"],
    "version": "1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0f"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/04fc306d-1109-4b7f-9d58-56e9a4c21710"
    },
    "ios": {
      "bundleIdentifier": "com.Sara.assetapp",
      "buildNumber": "1",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:ara-s-web.vercel.app", "applinks:arasasset.com"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.Sara.assetapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0a0a0f"
      },
      "blockedPermissions": ["com.google.android.gms.permission.AD_ID"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "ara-s-web.vercel.app" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "whatsNew": {
        "id": "2026-08-18-chart-fixes",
        "sections": [
          {
            "title": "優化",
            "items": [
              "修正資產損益的走勢圖一直停在載入中、圖表畫不出來的問題",
              "「納入圖表」關閉的資產，不再計入資產損益頁上方的資產與負債金額",
              "修正部分彈出視窗的按鈕文字消失，以及按鈕被畫面底部橫條遮住的問題",
              "「本次更新」說明改為分區塊呈現，較長的更新內容更好閱讀"
            ]
          },
          {
            "title": "立即重啟",
            "items": ["下次看到畫面下方的更新提示時，點「立即重啟」即可馬上套用新版本"]
          }
        ]
      },
      "eas": {
        "projectId": "04fc306d-1109-4b7f-9d58-56e9a4c21710"
      }
    },
    "owner": "milk88084"
  }
}

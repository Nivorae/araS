{
  "expo": {
    "name": "Sara Asset",
    "slug": "sara-asset-app",
    "scheme": "saraasset",
    "platforms": ["ios", "android"],
    "version": "1.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/04fc306d-1109-4b7f-9d58-56e9a4c21710"
    },
    "ios": {
      "bundleIdentifier": "com.Sara.assetapp",
      "buildNumber": "1",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:ara-s-web.vercel.app", "applinks:arasasset.com"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.Sara.assetapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0a0a0f"
      },
      "blockedPermissions": ["com.google.android.gms.permission.AD_ID"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ara-s-web.vercel.app"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-local-authentication",
        { "faceIDPermission": "使用 Face ID 解鎖 araS，保護你的資產資料" }
      ],
      "@sentry/react-native",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 390,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0f"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "whatsNew": {
        "id": "2026-09-18-insurer-logos",
        "sections": [
          {
            "title": "優化",
            "items": [
              "保單清單與詳情頁顯示保險公司 logo",
              "修正「本次更新」說明內容較長時無法捲動到底的問題"
            ]
          }
        ]
      },
      "eas": {
        "projectId": "04fc306d-1109-4b7f-9d58-56e9a4c21710"
      }
    },
    "owner": "milk88084"
  }
}

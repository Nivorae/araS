{
  "expo": {
    "name": "Sara Asset",
    "slug": "sara-asset-app",
    "scheme": "saraasset",
    "platforms": ["ios", "android"],
    "version": "1.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/04fc306d-1109-4b7f-9d58-56e9a4c21710"
    },
    "ios": {
      "bundleIdentifier": "com.Sara.assetapp",
      "buildNumber": "1",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:ara-s-web.vercel.app", "applinks:arasasset.com"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.Sara.assetapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0a0a0f"
      },
      "blockedPermissions": ["com.google.android.gms.permission.AD_ID"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ara-s-web.vercel.app"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-local-authentication",
        { "faceIDPermission": "使用 Face ID 解鎖 araS，保護你的資產資料" }
      ],
      "@sentry/react-native",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 390,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0f"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "whatsNew": {
        "id": "2026-10-01-v1.6-demo-mode",
        "sections": [
          {
            "title": "新功能",
            "items": [
              "新增示範模式：免費版可從付費頁或設定頁進入，用內建範例資料試用所有 Premium 功能，示範中的新增、修改、刪除都不會動到自己的資料",
              "保單清單與詳情頁顯示保險公司 logo"
            ]
          },
          {
            "title": "優化",
            "items": [
              "資產詳情頁重新設計：交易記錄改為左右交錯卡片並加上進場動畫、股息改為總覽卡片（當年股息／殖利率／明細），點擊可開啟完整股利清單",
              "貸款的「納入圖表」設定現在會正確儲存",
              "修正股利明細清單中，點選單筆記錄編輯或刪除後畫面失去反應的問題",
              "修正「本次更新」說明內容較長時無法捲動到底的問題",
              "更新登入元件與系統元件，提升帳號安全性與穩定性"
            ]
          }
        ]
      },
      "eas": {
        "projectId": "04fc306d-1109-4b7f-9d58-56e9a4c21710"
      }
    },
    "owner": "milk88084"
  }
}

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native — generated by `expo prebuild` (CNG). Must stay ignored: @expo/fingerprint
# treats a non-ignored ios/ as a bare project, so EAS (which prebuilds) and a
# local checkout (which doesn't) compute different runtime versions and the
# build fails in CONFIGURE_EXPO_UPDATES (build 18, 2026-10-01).
/ios
/android
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Env
.env
.env*.local

# Misc
npm-debug.*
yarn-error.*

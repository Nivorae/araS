generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Entry {
  id          String         @id @default(cuid())
  userId      String
  name        String
  topCategory String
  subCategory String
  stockCode   String?
  bankCode    String?
  note        String?
  value       Decimal
  includeInChart Boolean     @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  history     EntryHistory[]
  loan        Loan?
  insurance   Insurance?
  recurrences Recurrence[]
  dividends     Dividend[] @relation("EntryDividends")
  bankDividends Dividend[] @relation("BankDividends")

  @@index([topCategory])
  @@index([userId])
}

model Loan {
  id                 String        @id @default(cuid())
  entryId            String        @unique
  entry              Entry         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  loanName           String
  totalAmount        Decimal
  annualInterestRate Decimal
  termMonths         Int
  startDate          DateTime
  gracePeriodMonths  Int           @default(0)
  repaymentType      RepaymentType
  overrideTermMonths Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

enum RepaymentType {
  principal_interest
  principal_equal
}

enum RecurrenceFreq {
  MONTHLY
  WEEKLY
  BIWEEKLY
  YEARLY
}

enum InsuranceType {
  LIFE
  MEDICAL
  CANCER
  ACCIDENT
  SAVINGS_INVESTMENT
  LONGTERM_CARE
  OTHER
}

model EntryHistory {
  id             String   @id @default(cuid())
  entryId        String
  entry          Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  delta          Decimal
  balance        Decimal
  units          Decimal?
  pricePerShare  Decimal?
  note           String?
  createdAt      DateTime @default(now())

  @@index([entryId, createdAt])
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  type      String
  amount    Decimal
  category  String
  source    String
  note      String?
  date      DateTime
  createdAt DateTime @default(now())

  @@index([date])
  @@index([userId])
}

model PortfolioItem {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  name      String
  avgCost   Decimal
  shares    Decimal
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, symbol])
  @@index([userId])
}

model Insurance {
  id             String        @id @default(cuid())
  entryId        String        @unique
  entry          Entry         @relation(fields: [entryId], references: [id], onDelete: Cascade)

  // 核心必填
  insurer        String
  insuredName    String
  insuranceType  InsuranceType

  // 核心選填（null = 不確定）
  policyName       String?
  policyNumber     String?
  startDate        DateTime?
  paymentTermYears Int?
  coveragePeriod   String?
  annualPremium    Decimal?

  // 保障細項（最多 3）：[{ key, label, value }]
  coverage       Json          @default("[]")

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Recurrence {
  id          String         @id @default(cuid())
  userId      String
  entryId     String
  entry       Entry          @relation(fields: [entryId], references: [id], onDelete: Cascade)
  type        String
  amount      Decimal
  category    String
  source      String         @default("daily")
  note        String?
  frequency   RecurrenceFreq
  dayOfMonth  Int?
  dayOfWeek   Int?
  monthOfYear Int?
  startDate   DateTime
  nextRunAt   DateTime
  lastRunAt   DateTime?
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId, nextRunAt])
  @@index([entryId])
}

enum SubscriptionStatus {
  active
  expired
  grace_period
  revoked
}

// v2 IAP scaffolding — not read by any code path yet (see EntitlementsService).
// Populated exclusively by the App Store Server Notifications webhook;
// Apple's notification is the source of truth, never the client.
//
// appleAccountToken is `deriveAppleAccountToken(clerkUserId)` (see
// @repo/shared), not the raw Clerk userId — Apple's StoreKit2 appAccountToken
// must be a UUID, so purchase (mobile) and verification (this webhook) sides
// independently recompute the same deterministic UUID from the Clerk userId
// rather than needing a separate mapping table.
model Subscription {
  id                    String             @id @default(cuid())
  appleAccountToken     String             @unique
  productId             String
  status                SubscriptionStatus
  expiresAt             DateTime
  originalTransactionId String             @unique
  environment           String             @default("Production")
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

// Temporary: maps a user's OLD Clerk development-instance id to their new
// production id, so `lib/clerk-auth.ts` can keep serving iOS builds that still
// authenticate against the development instance. Populated from the pre-seed
// map by `scripts/clerk/remap-user-ids.ts`, in the same transaction as the id
// rewrite so the two can never disagree; every row mirrors the `external_id`
// stored on the corresponding production Clerk user.
//
// Drop this table once `CLERK_LEGACY_SECRET_KEY` has been removed from Vercel
// and old builds are no longer in circulation.
model UserIdMigration {
  legacyUserId String   @id
  userId       String
  email        String
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Dividend {
  id      String @id @default(cuid())
  userId  String
  entryId String
  entry   Entry  @relation("EntryDividends", fields: [entryId], references: [id], onDelete: Cascade)

  payDate  DateTime
  amount   Decimal
  perShare Decimal?
  shares   Decimal?
  note     String?

  bankEntryId   String?
  bankEntry     Entry?  @relation("BankDividends", fields: [bankEntryId], references: [id], onDelete: SetNull)
  bankHistoryId String?
  transactionId String?

  reinvestedAt          DateTime?
  reinvestAmount        Decimal?
  reinvestPrice         Decimal?
  reinvestUnits         Decimal?
  reinvestHistoryId     String?
  reinvestBankHistoryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, payDate])
  @@index([entryId])
}

node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
test-results/
playwright-report/
blob-report/
.playwright-mcp/

# next.js (legacy)
.next/
out/

# next-pwa generated service worker (apps/web)
apps/web/public/sw.js
apps/web/public/sw.js.map
apps/web/public/workbox-*.js
apps/web/public/workbox-*.js.map

# build output
dist/
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ignore every variant so ad-hoc copies (.env.bak, .env.prod-backup,
# .env.old) can never be committed, then re-allow the two that are deliberately
# tracked: the checked-in example, and the mobile production values that
# `eas update` inlines into OTA builds.
.env
.env.*
!.env.example
!apps/mobile/.env.production

# Clerk dev -> prod migration working files. The user map pairs real users'
# email addresses with their account ids; it must never reach the repo.
.clerk-migration/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
packages/server/prisma/*.db

# IDE
.idea/
.vscode/

# Claude Code local settings (settings.json is shared; local overrides are not)
.claude/settings.local.json

# Package manager lock file conflicts (pnpm project — ignore npm/yarn lock files)
package-lock.json
yarn.lock

# Service login accounts — this repo is public, so account identities stay local
docs/ACCOUNTS.local.md

# Windows
Thumbs.db
Desktop.ini
ehthumbs.db
bash.exe.stackdump
.turbo
.worktrees/
.superpowers/
.docs/superpowers/